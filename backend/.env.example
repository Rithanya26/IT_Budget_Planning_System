# Environment Variables - Local Development
# Copy this to .env and fill in your actual values

# Database Configuration (from Railway)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_railway_password_here
DB_NAME=railway

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000

# Note: Never commit the actual .env file to git!
# Only commit .env.example with dummy values
